{
  "name": "coupon-app",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter @coupon-app/web",
    "dev:mcp": "turbo run dev --filter @coupon-app/mcp",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ingest": "pnpm --filter @coupon-app/ingest run ingest",
    "log-prices": "pnpm --filter @coupon-app/adapters run log-prices",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
