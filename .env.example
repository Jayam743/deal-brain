# Supabase project (public — safe for the browser/extension; RLS enforces access, R-30).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix with NEXT_PUBLIC_ — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Best Buy Developer API (services/adapters/src/bestbuy.ts, pnpm log-prices).
# Server-side only, never NEXT_PUBLIC_ — absent means the adapter/logger fall
# back to fixtures/demo data and the app still builds and runs.
BEST_BUY_API_KEY=

# Phase 2+. Never NEXT_PUBLIC_.
WALMART_IMPACT_API_KEY=

# Web push (VAPID). The public key is safe client-side; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phase 2+ email alerts (Resend free tier, 100/day cap — batch).
RESEND_API_KEY=
